{
  "name": "The Dozen — Eggy setlist reader",
  "short_name": "The Dozen",
  "description": "A fast, mobile-first reader for The Carton's Eggy setlist archive: rotation and gap, recent setlists, position tendencies and jam charts.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#14110e",
  "theme_color": "#14110e",
  "categories": ["music", "utilities"],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
